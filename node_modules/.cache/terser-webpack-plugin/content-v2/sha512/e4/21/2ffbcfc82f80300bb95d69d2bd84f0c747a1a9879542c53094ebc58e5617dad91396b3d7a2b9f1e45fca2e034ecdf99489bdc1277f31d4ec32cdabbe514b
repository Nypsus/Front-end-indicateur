pas les vidéos HTML5.\n      </video>\n\n      <div className=\"content\">\n        <div className=\"wallet-connect-button\">\n          <button onClick={connectWallet} disabled={walletConnected}>\n            {walletConnected ? `Wallet connecté: ${walletAddress}` : 'Connecter le wallet'}\n          </button>\n        </div>\n\n        <div className=\"payment-wrapper\">\n          <h1>Les Indicateurs à Levier</h1>\n\n          {walletConnected && (\n            <div>\n              <p>Connecté avec : {walletAddress}</p>\n            </div>\n          )}\n\n          <select onChange={handleProductSelection} value={selectedProductId}>\n            <option value=\"\">Sélectionner un produit</option>\n            <option value=\"product1\">Produit 1</option>\n            <option value=\"product2\">Produit 2</option>\n            <option value=\"product3\">Produit 3</option>\n          </select>\n\n          {productInfo && (\n            <div>\n              <h3>Produit choisi : {productInfo.title}</h3>\n              <p>Prix en USDT : {productPrice} USDT</p>\n              <p>Prix équivalent en BNB : {convertedPrice ? convertedPrice.toFixed(6) : 'Chargement...'}</p>\n              <p>Disponibilité : {productInfo.exists ? 'Disponible' : 'Indisponible'}</p>\n            </div>\n          )}\n\n          <button onClick={handlePayment}>Payer pour le produit en BNB</button>\n\n          {errorMessage && <p style={{ color: 'red' }}>{errorMessage}</p>}\n        </div>\n      </div>\n    </div>\n  </div>\n);\n};\n\nexport default App;\n  ","import React from 'react';\nimport ReactDOM from 'react-dom/client';  // Cette ligne doit être valide avec React 18\nimport App from './App';\nimport './index.css'; // Ajoute cette ligne dans ton fichier JavaScript\nimport './App.css'; \n\n\nconst root = ReactDOM.createRoot(document.getElementById('root'));\nroot.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>\n);\n"]}}